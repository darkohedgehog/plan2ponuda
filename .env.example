# Plan2Ponuda / Ploro AI environment template
# Copy values into .env.local or your deployment provider.
# Do not commit real secrets. Variables prefixed with NEXT_PUBLIC_ are exposed
# to the browser bundle. All other variables are server-only unless noted.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public: browser-visible canonical app URL used for redirects and reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public: must be the absolute production website URL. Used for sitemap,
# robots, canonical URLs, and Open Graph URLs. Stripe and auth redirects use
# NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=https://example.com

# Runtime-managed by Next.js/Vercel. Documented because app code branches on it.
# Normally leave this unset in hosted production environments.
# NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Server-only: Prisma/Postgres connection string.
# Use the Supabase pooler/runtime connection for deployed serverless runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Server-only: NextAuth secret used to sign JWT/session data.
NEXTAUTH_SECRET=replace-with-random-secret

# Server-only/public URL value used by NextAuth runtime. Not a secret, but it
# does not need NEXT_PUBLIC_. Use the deployed app URL in production.
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public: browser-visible Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public: browser-visible Supabase publishable key. Prefer this variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Public: legacy fallback supported by the app. Use only if your Supabase
# project still exposes an anon key instead of a publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only: Supabase secret/service key. Never expose through NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Supabase Storage requirement: create a private bucket named "project-files".
# The bucket name is currently a code constant, not an env variable.

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Server-only: never expose this key through NEXT_PUBLIC_ or client code.
OPENAI_API_KEY=sk-replace-with-openai-api-key

# Server-only optional override. Leave empty/unset to use the app default model.
OPENAI_ANALYSIS_MODEL=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Server-only: keep test keys with test price IDs and live keys with live price
# IDs. Do not mix sk_test/price_test values with sk_live/live prices.
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_BASIC_PRICE_ID=price_replace_with_basic_price_id
STRIPE_PRO_PRICE_ID=price_replace_with_pro_price_id

# Server-only: local value comes from Stripe CLI `stripe listen`.
# Production value comes from the Stripe Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret

# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
# Server-only: Hostinger SMTP example. Do not commit the real mailbox password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@example.com

# Server-only: wrap passwords with spaces or special characters in quotes.
SMTP_PASSWORD="replace-with-smtp-mailbox-password"

SMTP_FROM_EMAIL=contact@example.com

# Server-only: wrap names with spaces or special characters in quotes.
SMTP_FROM_NAME="Ploro AI"

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------
# Server-only: enable or disable Turnstile verification (true/false).
# Recommended local default is false unless intentionally testing Turnstile.
# Use true in staging and production.
TURNSTILE_ENABLED=false

# Public: browser-safe Turnstile site key exposed to the client bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: Turnstile secret key used for server-side token verification.
# Never expose this value through NEXT_PUBLIC_ or client code.
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile allowed hostnames must include staging and production
# domains. For localhost testing, either keep TURNSTILE_ENABLED=false or add
# localhost as an allowed hostname in Cloudflare.
