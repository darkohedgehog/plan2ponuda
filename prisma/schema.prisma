// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // TODO: Add directUrl = env("DIRECT_URL") once DIRECT_URL is configured for migrations.
}

enum ProjectStatus {
  draft
  uploaded
  analyzing
  reviewed
  quoted
  failed
}

enum ObjectType {
  apartment
  house
  office
}

enum RoomType {
  living_room
  bedroom
  kitchen
  bathroom
  hallway
  office
  unknown
}

enum MaterialUnit {
  pcs
  m
  set
}

enum MaterialCategory {
  cable
  socket
  switch
  breaker
  box
  panel
  other
}

enum AnalysisStatus {
  pending
  success
  failed
}

enum UserRole {
  user
  admin
}

enum BillingPlan {
  free
  basic
  pro
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum CustomerType {
  croatian_individual
  croatian_business_b2b
  croatian_b2g
  eu_business
  eu_b2g_needs_review
  outside_eu
}

enum InvoiceTaskStatus {
  pending
  issued
  failed
  needs_review
  not_required
}

enum UsageCounterType {
  floor_plans_created
  quotes_created
  large_pdf_analyses_used
}

enum ProjectDocumentStatus {
  uploaded
  analysis_pending
  analyzing
  analyzed
  failed
}

enum ProjectDocumentAnalysisStatus {
  pending
  analyzing
  completed
  failed
}

enum ProjectDocumentCandidateType {
  material
  labor
}

enum ProjectDocumentCandidateStatus {
  pending
  accepted
  rejected
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String?
  companyName  String?
  emailVerifiedAt DateTime?
  role         UserRole  @default(user)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]
  settings     UserSettings?
  subscription Subscription?
  billingProfile BillingProfile?
  invoiceTasks InvoiceTask[]
  usageCounters UsageCounter[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([createdAt])
  @@index([emailVerifiedAt])
  @@index([role])
}

model UserSettings {
  id             String    @id @default(cuid())
  userId         String    @unique
  companyAddress String?
  companyCity    String?
  companyCountry String?
  companyTaxId   String?
  companyPhone   String?
  companyEmail   String?
  laborFactor    Decimal   @default(12) @db.Decimal(10, 2)
  currency       String    @default("EUR")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id             String           @id @default(cuid())
  userId         String
  name           String
  clientName     String?
  objectType     ObjectType
  areaM2         Float
  status         ProjectStatus    @default(draft)
  sourceFilePath String?
  previewPath    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms          Room[]
  materials      ProjectMaterial[]
  analyses       Analysis[]
  documents      ProjectDocument[]
  quote          Quote?

  @@index([userId, createdAt])
  @@index([userId, status])
}

model Room {
  id              String          @id @default(cuid())
  projectId       String
  name            String
  type            RoomType        @default(unknown)
  estimatedAreaM2 Float?
  confidence      Float?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suggestion      RoomSuggestion?

  @@index([projectId, sortOrder])
  @@index([projectId, type])
}

model RoomSuggestion {
  id                String    @id @default(cuid())
  roomId            String    @unique
  suggestedSockets  Int       @default(0)
  suggestedSwitches Int       @default(0)
  suggestedLights   Int       @default(0)
  userSockets       Int?
  userSwitches      Int?
  userLights        Int?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Material {
  id           String            @id @default(cuid())
  code         String?           @unique
  name         String
  unit         MaterialUnit
  defaultPrice Decimal           @db.Decimal(10, 2)
  category     MaterialCategory
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  projectItems ProjectMaterial[]

  @@index([category])
}

model ProjectMaterial {
  id         String    @id @default(cuid())
  projectId  String
  materialId String?
  manualName String?
  manualUnit MaterialUnit?
  manualCategory MaterialCategory?
  quantity   Decimal   @db.Decimal(10, 2)
  unitPrice  Decimal   @db.Decimal(10, 2)
  totalPrice Decimal   @db.Decimal(10, 2)
  source     String    @default("rule")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([materialId])
  @@unique([projectId, materialId])
}

model Analysis {
  id                 String         @id @default(cuid())
  projectId          String
  provider           String
  rawResponseJson    Json?
  parsedResponseJson Json?
  status             AnalysisStatus @default(pending)
  errorMessage       String?
  createdAt          DateTime       @default(now())

  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectDocument {
  id        String                @id @default(cuid())
  projectId String
  filePath  String
  fileName  String
  mimeType  String
  sizeBytes Int
  status    ProjectDocumentStatus @default(uploaded)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses  ProjectDocumentAnalysis[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model ProjectDocumentAnalysis {
  id                 String                        @id @default(cuid())
  projectDocumentId  String
  provider           String
  model              String?
  status             ProjectDocumentAnalysisStatus @default(pending)
  rawResponseJson    Json?
  parsedResponseJson Json?
  errorMessage       String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  document           ProjectDocument               @relation(fields: [projectDocumentId], references: [id], onDelete: Cascade)
  candidates         ProjectDocumentCandidate[]

  @@index([projectDocumentId])
  @@index([status])
  @@index([createdAt])
}

model ProjectDocumentCandidate {
  id                        String                         @id @default(cuid())
  projectDocumentAnalysisId String
  type                      ProjectDocumentCandidateType
  status                    ProjectDocumentCandidateStatus @default(pending)

  name                      String
  description               String?
  category                  String?
  unit                      String
  quantity                  Decimal?
  unitPrice                 Decimal?                       @db.Decimal(10, 2)
  totalPrice                Decimal?                       @db.Decimal(10, 2)

  sourceReference           String?
  confidence                Decimal?                       @db.Decimal(4, 3)
  notes                     String?

  originalJson              Json?
  sortOrder                 Int                            @default(0)
  importedAt                DateTime?
  importedProjectMaterialId String?
  importedLaborItemId       String?

  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  analysis                  ProjectDocumentAnalysis        @relation(fields: [projectDocumentAnalysisId], references: [id], onDelete: Cascade)

  @@index([projectDocumentAnalysisId])
  @@index([type])
  @@index([status])
  @@index([importedAt])
  @@index([importedProjectMaterialId])
  @@unique([projectDocumentAnalysisId, type, sortOrder])
}

model Quote {
  id           String    @id @default(cuid())
  projectId    String    @unique
  laborCost    Decimal   @db.Decimal(10, 2)
  materialCost Decimal   @db.Decimal(10, 2)
  subtotal     Decimal   @db.Decimal(10, 2)
  total        Decimal   @db.Decimal(10, 2)
  pdfPath      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 BillingPlan        @default(free)
  status               SubscriptionStatus @default(active)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
  @@index([currentPeriodEnd])
}

model BillingProfile {
  id                   String       @id @default(cuid())
  userId               String       @unique
  customerType         CustomerType
  billingName          String
  billingEmail         String
  billingAddressLine1  String
  billingAddressLine2  String?
  billingCity          String
  billingPostalCode    String
  billingCountry       String
  companyName          String?
  contactPerson        String?
  vatId                String?
  taxId                String?
  oib                  String?
  phone                String?
  purchaseOrderNumber  String?
  eInvoiceReference    String?
  procurementReference String?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerType])
  @@index([billingCountry])
}

model BillingEvent {
  id              String    @id @default(cuid())
  stripeEventId   String    @unique
  eventType       String
  processedAt     DateTime?
  processingError String?
  payload         Json
  createdAt       DateTime  @default(now())

  @@index([eventType])
  @@index([processedAt])
  @@index([createdAt])
}

model InvoiceTask {
  id                    String            @id @default(cuid())
  userId                String
  status                InvoiceTaskStatus @default(pending)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripeInvoiceId       String?           @unique
  stripePaymentIntentId String?
  stripeEventId         String?
  periodStart           DateTime?
  periodEnd             DateTime?
  amountPaid            Decimal?          @db.Decimal(10, 2)
  currency              String            @default("EUR")
  customerType          CustomerType
  billingSnapshot       Json
  synesisInvoiceNumber  String?
  adminNotes            String?
  reviewedAt            DateTime?
  issuedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([stripeInvoiceId])
}

model UsageCounter {
  id          String           @id @default(cuid())
  userId      String
  type        UsageCounterType
  periodKey   String           @default("lifetime")
  count       Int              @default(0)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([periodEnd])
  @@unique([userId, type, periodKey])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  scope       String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, scope, windowStart])
  @@index([expiresAt])
}
